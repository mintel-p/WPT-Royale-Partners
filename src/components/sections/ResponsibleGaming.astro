---
/**
 * ResponsibleGaming — Figma Desktop 0:1496 ("responsible-gaming"): the two-line notice (0:1497) next to the
 * regulator row (0:1498 = the hero's "Logos" 0:261, same size and order → ui/ComplianceLogos).
 * Padding 24 / 80 (a one-off), the bottom stroke #1e2e4a 60 % 1px takes no layout space (frame 82 = 24 + 34 + 24).
 * A <div>: no heading. No data-reveal: a regulatory notice that must always be visible (as the last element
 * it would sit in the reveal observer's excluded bottom 10 % at max scroll).
 * Tablet 2039:1840: the notice above the regulator row (gap 16), padding 20 / 40, the logos spread over
 * the 688 column (ComplianceLogos type="stretch").
 * Mobile 2053:4778: padding 24 / 16 (the container's), the notice one paragraph (both sentences run on), → logos 20.
 */
import ComplianceLogos from '@/components/ui/ComplianceLogos.astro';
import { useTranslations } from '@/i18n';

interface Props {
  text?: string;
  support?: string;
}

const t = useTranslations(Astro.currentLocale).responsibleGaming;
const { text = t.text, support = t.support } = Astro.props;
---

<div class="section">
  <div class="background-slot responsible-gaming_line" aria-hidden="true"></div>
  <div class="container">
    <div class="responsible-gaming_row spacing-0/16/20">
      <div class="responsible-gaming_text text-size-caption text-color-secondary">
        <p>{text}</p>
        <p>{support}</p>
      </div>
      <ComplianceLogos type="stretch" />
    </div>
  </div>
</div>

<style>
  .responsible-gaming_line {
    border-bottom: var(--size-1) solid var(--theme-border-strong);
  }
  .responsible-gaming_row {
    display: flex;
    align-items: center;
    padding-block: var(--size-24);
  }
  .spacing-0\/16\/20 {
    gap: 0;
  }
  .responsible-gaming_text {
    flex: 1;
    min-width: 0;
  }

  @media (max-width: 991px) {
    .responsible-gaming_row {
      flex-direction: column;
      align-items: stretch;
      padding: var(--size-20) var(--size-8);
    }
    .spacing-0\/16\/20 {
      gap: var(--size-16);
    }
  }

  @media (max-width: 479px) {
    .responsible-gaming_row {
      padding: var(--size-24) 0;
    }
    .spacing-0\/16\/20 {
      gap: var(--size-20);
    }
    /* "card-desc" 2053:4779 is one text: the two sentences run on in one paragraph */
    .responsible-gaming_text > p {
      display: inline;
    }
    .responsible-gaming_text > p + p::before {
      content: ' ';
    }
  }
</style>
